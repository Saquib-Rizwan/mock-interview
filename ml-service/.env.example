# Get a free key at https://aistudio.google.com/apikey (no card required).
GEMINI_API_KEY=your-key-here

# Optional. Defaults to gemini-3.6-flash if unset.
# Note: gemini-2.0/2.5 models no longer have free-tier quota — they fail with
# "limit: 0". If this model is ever retired, gemini-flash-latest is an alias
# that tracks whatever the current flash model is.
GEMINI_MODEL=gemini-3.6-flash
