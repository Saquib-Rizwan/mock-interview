PORT=4000
ML_SERVICE_URL=http://localhost:8001
DATABASE_URL="postgresql://mockinterview:mockinterview@localhost:5433/mockinterview"

# Signs and verifies JWTs. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-random-64-char-hex-string
JWT_EXPIRES_IN=7d

# Judge0 code execution. Any Judge0-compatible host works — the URL is the only
# thing that changes when you move it, so this is a config decision, not a code one.
# Judge0 requires cgroup v1, which Docker Desktop and WSL2 cannot provide;
# it needs a real Linux VM. See docs/phase-log/phase-6-*.md.
JUDGE0_URL=http://your-judge0-host:2358
JUDGE0_TOKEN=replace-me-with-the-AUTHN_TOKEN-from-judge0.conf
